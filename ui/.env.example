# Discord Bot Configuration
# Copy this file to .env and fill in your values

# Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# Discord Server (Guild) ID
DISCORD_GUILD_ID=1470564141071597722

# Discord Channel ID for bot notifications
DISCORD_CHANNEL_ID=1470564348165488853

# Database path (shared with web app)
DATABASE_PATH=/app/ui/sessions.db

# Screenshot storage directory (shared with web app)
SCREENSHOT_DIR=/app/ui/bug_report_screenshots

# How often to check for new reports (seconds)
CHECK_INTERVAL=60
